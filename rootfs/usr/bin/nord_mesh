#!/usr/bin/env bash

function enable_meshnet(){
  echo "Attempting to toggle meshnet on..."
    current_sleep=1
    until nordvpn set meshnet on; do
      if [ ${current_sleep} -gt 4096 ]; then
        echo "Unable to toggle meshnet on."
        exit 1
      fi
      echo "Unable to toggle meshnet on. retrying in ${current_sleep} seconds."
      sleep ${current_sleep}
      current_sleep=$((current_sleep * 2))
    done
}


if [[ -n ${MESHNET} ]]; then
  MESH_STATUS=$(nordvpn settings)
  MESH_STATUS=($(echo "$MESH_STATUS" | awk '/Meshnet:/ {print $2}'))

  if [ ${MESH_STATUS} != "enabled" ]; then
    sleep 1
    enable_meshnet
  else
    echo "Meshnet already enabled."
#  else
#    echo "Meshnet already enabled. Toggling off and on again."
#    nordvpn set meshnet off
#    sleep 5
#    enable_meshnet
  fi

  echo "======config complete======"

fi

exit 0

# --sysctl net.ipv4.conf.all.src_valid_mark=1
#--cap-add NET_RAW --cap-add SYS_MODULE  --sysctl net.ipv4.conf.all.src_valid_mark=1